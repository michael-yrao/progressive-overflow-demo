{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://progressiveoverflow.com/schemas/manifest.v1.json",
  "title": "cse-coach dashboard manifest contract",
  "description": "dashboard/manifest.json, emitted by scripts/export_manifest.py: the sha256 and byte size of every other dashboard JSON (LF-normalized), keyed by path relative to dashboard/, so the site re-fetches only what changed.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "files"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
